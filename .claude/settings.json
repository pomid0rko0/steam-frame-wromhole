{
  "hooks": {
    "SubagentStop": [
      {
        "matcher": "^blind-designer$",
        "hooks": [
          {"type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/blind_design.sh done"}
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {"type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/blind_design.sh stop"}
        ]
      }
    ]
  }
}
