+	if (max(max(v_col.r, v_col.g), v_col.b) <= 1.0) {
+		int f = ab.x >= ab.y && ab.x >= ab.z ? 0 : (ab.y >= ab.z ? 1 : 2);
+		bool neg = (f == 0 ? v_box.x : (f == 1 ? v_box.y : v_box.z)) < 0.0;
+		col = f == 0 ? (neg ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0)) : (f == 1 ? (neg ? vec3(1.0, 1.0, 0.0) : vec3(0.0, 0.0, 1.0))
+				: (neg ? vec3(1.0, 0.0, 1.0) : vec3(0.0, 1.0, 1.0)));
+	}
+#endif
 #else
 	vec4 n = normalize(v_n);
 	float nl = dot(n, normalize(v_sun));
